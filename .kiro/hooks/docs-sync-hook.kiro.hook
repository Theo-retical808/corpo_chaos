{
  "enabled": true,
  "name": "Documentation Sync",
  "description": "Automatically updates README.md and documentation files when C# source files, XAML files, or project configuration files are modified",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.cs",
      "*.xaml",
      "*.csproj",
      "*.md"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file has been modified. Please review the changes and update the README.md file and any relevant documentation in the project to reflect any new features, architectural changes, or important modifications. Focus on keeping the documentation accurate and up-to-date with the current codebase state."
  }
}