<Window x:Class="CorporateChaos.Views.QuarterlySummary"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quarterly Summary" Height="500" Width="700" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Border Background="#1a1a2e" CornerRadius="12" BorderBrush="#2a3a5e" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Custom Title Bar -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1e2e4e" Offset="0"/>
                        <GradientStop Color="#162040" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <TextBlock x:Name="QuarterTitleText" Text="📊 QUARTERLY SUMMARY - Q1" FontSize="14" FontWeight="Bold" 
                              Foreground="White" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    <Button Content="✕" Width="36" Height="28" HorizontalAlignment="Right" Margin="0,0,8,0"
                            Click="CloseBtn_Click" Style="{StaticResource CloseButton}"/>
                </Grid>
            </Border>
            
            <!-- Content -->
            <Grid Grid.Row="1" Margin="20,10,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15" HorizontalAlignment="Center">
                <TextBlock Text="Review your company's performance and recent events" 
                          FontSize="12" Foreground="LightGray" HorizontalAlignment="Center"/>
        </StackPanel>
        
        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar">
                    <Setter Property="Background" Value="#2a2a3e"/>
                    <Setter Property="BorderBrush" Value="#4a4a5e"/>
                    <Setter Property="Foreground" Value="#6a6a7e"/>
                    <Setter Property="Width" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid>
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="1" CornerRadius="6"/>
                                    <Track Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="#5a5a7e" CornerRadius="6" 
                                                                BorderBrush="#7a7a9e" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#7a7a9e"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ScrollViewer.Resources>
            <StackPanel>
                <!-- Financial Performance -->
                <Border Background="#16213e" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="💰 FINANCIAL PERFORMANCE" FontSize="14" FontWeight="Bold" 
                                  Foreground="White" Margin="0,0,0,10"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Revenue" FontSize="11" Foreground="Gray"/>
                                <TextBlock x:Name="RevenueText" Text="$0" FontSize="14" FontWeight="Bold" Foreground="LightGreen"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Expenses" FontSize="11" Foreground="Gray"/>
                                <TextBlock x:Name="ExpensesText" Text="$0" FontSize="14" FontWeight="Bold" Foreground="LightCoral"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="NetResultLabel" Text="Net Profit" FontSize="11" Foreground="Gray"/>
                                <TextBlock x:Name="NetResultText" Text="$0" FontSize="14" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Company Metrics -->
                <Border Background="#16213e" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📈 COMPANY METRICS" FontSize="14" FontWeight="Bold" 
                                  Foreground="White" Margin="0,0,0,10"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Capital" FontSize="11" Foreground="Gray"/>
                                <TextBlock x:Name="CapitalText" Text="$0" FontSize="12" FontWeight="Bold" Foreground="LightGreen"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Reputation" FontSize="11" Foreground="Gray"/>
                                <TextBlock x:Name="ReputationText" Text="0" FontSize="12" FontWeight="Bold" Foreground="Yellow"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Morale" FontSize="11" Foreground="Gray"/>
                                <TextBlock x:Name="MoraleText" Text="0" FontSize="12" FontWeight="Bold" Foreground="Pink"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Risk" FontSize="11" Foreground="Gray"/>
                                <TextBlock x:Name="RiskText" Text="0" FontSize="12" FontWeight="Bold" Foreground="Orange"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Recent Events -->
                <Border Background="#16213e" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="📰 RECENT EVENTS" FontSize="14" FontWeight="Bold" 
                                  Foreground="White" Margin="0,0,0,10"/>
                        
                        <ScrollViewer Height="150" VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.CanContentScroll="True">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar">
                                    <Setter Property="Background" Value="#1a1a2e"/>
                                    <Setter Property="BorderBrush" Value="#3a3a4e"/>
                                    <Setter Property="Foreground" Value="#5a5a6e"/>
                                    <Setter Property="Width" Value="10"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ScrollBar">
                                                <Grid>
                                                    <Border Background="{TemplateBinding Background}" 
                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                            BorderThickness="1" CornerRadius="5"/>
                                                    <Track Name="PART_Track" IsDirectionReversed="True">
                                                        <Track.Thumb>
                                                            <Thumb>
                                                                <Thumb.Template>
                                                                    <ControlTemplate TargetType="Thumb">
                                                                        <Border Background="#4a4a6e" CornerRadius="5" 
                                                                                BorderBrush="#6a6a8e" BorderThickness="1">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Style.Triggers>
                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                            <Setter Property="Background" Value="#6a6a8e"/>
                                                                                        </Trigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Thumb.Template>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                    </Track>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ScrollViewer.Resources>
                            <TextBlock x:Name="EventsText" Text="No events this quarter." 
                                      FontSize="10" Foreground="White" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Bottom Info -->
        <TextBlock Grid.Row="2" Text="💡 Tip: Click 'Current Events' button to review this summary anytime" 
                  FontSize="11" Foreground="Gray" HorizontalAlignment="Center" Margin="0,15,0,0"/>
    </Grid>
    </Grid>
    </Border>
</Window>