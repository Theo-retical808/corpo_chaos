<Window x:Class="CorporateChaos.Views.HighScoresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="High Scores - Corporate Chaos" Height="600" Width="1000" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/styles/ScrollBarStyles.xaml"/>
                <ResourceDictionary Source="/styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/styles/GameTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Border Background="#1a1a2e" CornerRadius="12" BorderBrush="#2a3a5e" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Custom Title Bar -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1e2e4e" Offset="0"/>
                        <GradientStop Color="#162040" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <TextBlock Text="🏆 HIGH SCORES" FontSize="14" FontWeight="Bold" 
                              Foreground="White" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    <Button Content="✕" Width="36" Height="28" HorizontalAlignment="Right" Margin="0,0,8,0"
                            Click="CloseButton_Click" Style="{StaticResource CloseButton}"/>
                </Grid>
            </Border>
            
            <!-- Content -->
            <Grid Grid.Row="1" Margin="20,10,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,15">
            <TextBlock Text="🏆 PEAK PERFORMANCE" FontSize="22" FontWeight="Bold" 
                       Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="Scores based on your highest achievements during the run" FontSize="12" 
                       Foreground="Gray" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
        
        <Border Grid.Row="1" Background="#16213e" CornerRadius="10" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource CorporateChaosScrollBar}"/>
                </ScrollViewer.Resources>
                <DataGrid x:Name="HighScoresDataGrid" AutoGenerateColumns="False" 
                          Background="Transparent" Foreground="White" 
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          CanUserAddRows="False" CanUserDeleteRows="False" 
                          CanUserReorderColumns="False" CanUserResizeRows="False"
                          IsReadOnly="True">
                    
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0f3460"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="8,5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2a2a4e"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="5,3"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.CellStyle>
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="50"/>
                        <DataGridTextColumn Header="Player" Binding="{Binding Nickname}" Width="100"/>
                        <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat=N0}" Width="80"/>
                        <DataGridTextColumn Header="Peak Capital" Binding="{Binding PeakCapital, StringFormat=C0}" Width="100"/>
                        <DataGridTextColumn Header="Peak Revenue" Binding="{Binding PeakRevenue, StringFormat=C0}" Width="100"/>
                        <DataGridTextColumn Header="Peak Profit" Binding="{Binding PeakProfit, StringFormat=C0}" Width="100"/>
                        <DataGridTextColumn Header="Peak Market %" Binding="{Binding PeakMarketShare, StringFormat=F1}" Width="90"/>
                        <DataGridTextColumn Header="Peak Staff" Binding="{Binding PeakEmployees}" Width="70"/>
                        <DataGridTextColumn Header="Quarters" Binding="{Binding QuartersPlayed}" Width="70"/>
                        <DataGridTextColumn Header="End Reason" Binding="{Binding EndReason}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
        </Border>
        
        <Button Grid.Row="2" Content="Close" Width="100" Height="35" 
                HorizontalAlignment="Center" Margin="0,20,0,0" 
                Click="CloseButton_Click"/>
    </Grid>
    </Grid>
    </Border>
</Window>