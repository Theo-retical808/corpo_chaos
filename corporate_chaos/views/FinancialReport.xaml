<Window x:Class="CorporateChaos.Views.FinancialReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Financial Report" Height="550" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/styles/ScrollBarStyles.xaml"/>
                <ResourceDictionary Source="/styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/styles/GameTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Border Background="#1a1a2e" CornerRadius="12" BorderBrush="#2a3a5e" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Custom Title Bar -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1e2e4e" Offset="0"/>
                        <GradientStop Color="#162040" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <TextBlock x:Name="TitleText" Text="📑 FINANCIAL REPORT - Q0" FontSize="14" FontWeight="Bold" 
                              Foreground="White" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    <Button Content="✕" Width="36" Height="28" HorizontalAlignment="Right" Margin="0,0,8,0"
                            Click="CloseBtn_Click" Style="{StaticResource CloseButton}"/>
                </Grid>
            </Border>
            
            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,10,20,20">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource CorporateChaosScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel>
                    
                    <!-- Revenue Section -->
                    <Border Background="#1a3a2a" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="📈 REVENUE" FontSize="14" FontWeight="Bold" Foreground="#7dcea0" Margin="0,0,0,10"/>
                            
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Base Revenue (Market Share)" FontSize="12" Foreground="#a0a0b0"/>
                                <TextBlock x:Name="BaseRevenueText" Text="$0" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Department Productivity Bonus" FontSize="12" Foreground="#a0a0b0"/>
                                <TextBlock x:Name="DeptBonusText" Text="+$0" FontSize="12" FontWeight="Bold" Foreground="#7dcea0" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Reputation Modifier" FontSize="12" Foreground="#a0a0b0"/>
                                <TextBlock x:Name="ReputationModText" Text="x1.00" FontSize="12" FontWeight="Bold" Foreground="#85c1e9" HorizontalAlignment="Right"/>
                            </Grid>
                            
                            <Border BorderBrush="#3a5a4a" BorderThickness="0,1,0,0" Margin="0,8,0,4" Padding="0,6,0,0">
                                <Grid>
                                    <TextBlock Text="Total Revenue" FontSize="13" FontWeight="Bold" Foreground="#7dcea0"/>
                                    <TextBlock x:Name="TotalRevenueText" Text="$0" FontSize="13" FontWeight="Bold" Foreground="#7dcea0" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- Expenses Section -->
                    <Border Background="#3a1a1a" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="📉 EXPENSES" FontSize="14" FontWeight="Bold" Foreground="#e8a0a0" Margin="0,0,0,10"/>
                            
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Employee Salaries" FontSize="12" Foreground="#a0a0b0"/>
                                <TextBlock x:Name="SalariesText" Text="$0" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Operational Costs" FontSize="12" Foreground="#a0a0b0"/>
                                <TextBlock x:Name="OperationalText" Text="$0" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Executive Decisions" FontSize="12" Foreground="#a0a0b0"/>
                                <TextBlock x:Name="DecisionExpText" Text="$0" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Crisis / Event Losses" FontSize="12" Foreground="#a0a0b0"/>
                                <TextBlock x:Name="CrisisLossText" Text="$0" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            
                            <Border BorderBrush="#5a3a3a" BorderThickness="0,1,0,0" Margin="0,8,0,4" Padding="0,6,0,0">
                                <Grid>
                                    <TextBlock Text="Total Expenses" FontSize="13" FontWeight="Bold" Foreground="#e8a0a0"/>
                                    <TextBlock x:Name="TotalExpensesText" Text="$0" FontSize="13" FontWeight="Bold" Foreground="#e8a0a0" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <!-- Net Result Section -->
                    <Border x:Name="NetResultBorder" Background="#1a2a3a" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock x:Name="NetResultLabel" Text="NET PROFIT" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NetResultText" Text="$0" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <!-- Capital Change -->
                    <Border Background="#16213e" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#2a3a5e" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="💰 CAPITAL SUMMARY" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Capital (Start of Quarter)" FontSize="12" Foreground="#a0a0b0"/>
                                <TextBlock x:Name="StartCapitalText" Text="$0" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <TextBlock x:Name="CapitalChangeLabel" Text="Change" FontSize="12" Foreground="#a0a0b0"/>
                                <TextBlock x:Name="CapitalChangeText" Text="+$0" FontSize="12" FontWeight="Bold" Foreground="#7dcea0" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border BorderBrush="#2a3a5e" BorderThickness="0,1,0,0" Margin="0,8,0,4" Padding="0,6,0,0">
                                <Grid>
                                    <TextBlock Text="Capital (End of Quarter)" FontSize="13" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock x:Name="EndCapitalText" Text="$0" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
