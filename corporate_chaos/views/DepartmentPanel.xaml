<Window x:Class="CorporateChaos.Views.DepartmentPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:CorporateChaos.Converters"
        Title="Department Management" Height="700" Width="900" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/styles/ScrollBarStyles.xaml"/>
                <ResourceDictionary Source="/styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/styles/GameTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:PathToImageSourceConverter x:Key="PathToImageConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    
    <Border Background="#1a1a2e" CornerRadius="12" BorderBrush="#2a3a5e" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Custom Title Bar -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1e2e4e" Offset="0"/>
                        <GradientStop Color="#162040" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <TextBlock x:Name="DepartmentTitleText" Text="🏢 DEPARTMENT MANAGEMENT" FontSize="14" FontWeight="Bold" 
                              Foreground="White" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    <Button Content="✕" Width="36" Height="28" HorizontalAlignment="Right" Margin="0,0,8,0"
                            Click="CloseBtn_Click" Style="{StaticResource CloseButton}"/>
                </Grid>
            </Border>
            
            <!-- Content -->
            <Grid Grid.Row="1" Margin="20,10,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="DepartmentStatsText" Text="Department Statistics" 
                      FontSize="12" Foreground="LightGray" HorizontalAlignment="Center"/>
            <TextBlock Text="💡 Strategic Tip: Look at employee skill keywords and stats to determine the best department assignment for optimal performance" 
                      FontSize="11" Foreground="LightBlue" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Current Department Employees -->
            <Border Grid.Column="0" Background="#16213e" CornerRadius="10" Padding="15" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="👥 Current Employees" FontSize="16" FontWeight="Bold" 
                              Foreground="White" Margin="0,0,0,15"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource CorporateChaosScrollBar}"/>
                        </ScrollViewer.Resources>
                        <ItemsControl x:Name="DepartmentEmployeesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2a4d3a" CornerRadius="8" Margin="0,0,0,10" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Profile Picture -->
                                            <Border Grid.Column="0" Width="50" Height="50" CornerRadius="25" 
                                                   Background="White" Margin="0,0,10,0" VerticalAlignment="Top">
                                                <Image Width="48" Height="48" Stretch="UniformToFill" ClipToBounds="True"
                                                       Source="{Binding ProfileImagePath, Converter={StaticResource PathToImageConverter}}">
                                                    <Image.Clip>
                                                        <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24"/>
                                                    </Image.Clip>
                                                </Image>
                                            </Border>
                                            
                                            <!-- Employee Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" 
                                                          Foreground="White" Margin="0,0,0,3"/>
                                                
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="🏆 " FontSize="10"/>
                                                    <TextBlock Text="{Binding OverallSkill}" FontSize="10" Foreground="Yellow"/>
                                                    <TextBlock Text=" | 📅 " FontSize="10" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding Experience}" FontSize="10" Foreground="Cyan"/>
                                                    <TextBlock Text=" yrs" FontSize="10" Foreground="Cyan"/>
                                                </StackPanel>
                                                
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="📈 " FontSize="10"/>
                                                    <TextBlock Text="{Binding Productivity}" FontSize="10" Foreground="LightGreen"/>
                                                    <TextBlock Text=" | 😊 " FontSize="10" Margin="10,0,0,0"/>
                                                    <TextBlock Text="{Binding Morale}" FontSize="10" Foreground="Pink"/>
                                                </StackPanel>
                                                
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="💰 $" FontSize="10" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding Salary, StringFormat=N0}" FontSize="10" Foreground="LightGreen"/>
                                                    <TextBlock Text="/month | ⚠️ " FontSize="10" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding RiskLevel}" FontSize="10" Foreground="Orange"/>
                                                </StackPanel>
                                            </StackPanel>
                                            
                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Top">
                                                <Button Content="🔄 Transfer" MinWidth="80" Height="28" Padding="8,0"
                                                       Background="#4d2a4d" Foreground="White" BorderBrush="#7a4d7a"
                                                       Click="TransferBtn_Click" Tag="{Binding}" Margin="0,0,0,5"/>
                                                <Button Content="🔥 Fire" MinWidth="80" Height="28" Padding="8,0"
                                                       Background="#8b2635" Foreground="White" BorderBrush="#b83545"
                                                       Click="FireBtn_Click" Tag="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- Available Hired Employees -->
            <Border Grid.Column="1" Background="#16213e" CornerRadius="10" Padding="15" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="📋 Available Employees" FontSize="16" FontWeight="Bold" 
                              Foreground="White" Margin="0,0,0,15"/>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource CorporateChaosScrollBar}"/>
                        </ScrollViewer.Resources>
                        <ItemsControl x:Name="AvailableEmployeesItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2a2a4d" CornerRadius="8" Margin="0,0,0,10" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Profile Picture -->
                                            <Border Grid.Column="0" Width="50" Height="50" CornerRadius="25" 
                                                   Background="White" Margin="0,0,10,0" VerticalAlignment="Top">
                                                <Image Width="48" Height="48" Stretch="UniformToFill" ClipToBounds="True"
                                                       Source="{Binding ProfileImagePath, Converter={StaticResource PathToImageConverter}}">
                                                    <Image.Clip>
                                                        <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24"/>
                                                    </Image.Clip>
                                                </Image>
                                            </Border>
                                            
                                            <!-- Employee Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" 
                                                          Foreground="White" Margin="0,0,0,3"/>
                                                
                                                <!-- Skill Keywords Display -->
                                                <ItemsControl ItemsSource="{Binding SkillKeywords}" Margin="0,0,0,5">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#4a4a6d" CornerRadius="3" Padding="4,2" Margin="0,0,3,2">
                                                                <TextBlock Text="{Binding}" FontSize="9" Foreground="LightBlue" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="🏆 " FontSize="10"/>
                                                    <TextBlock Text="{Binding OverallSkill}" FontSize="10" Foreground="Yellow"/>
                                                    <TextBlock Text=" | 📅 " FontSize="10" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding Experience}" FontSize="10" Foreground="Cyan"/>
                                                    <TextBlock Text=" yrs" FontSize="10" Foreground="Cyan"/>
                                                </StackPanel>
                                                
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="📈 " FontSize="10"/>
                                                    <TextBlock Text="{Binding Productivity}" FontSize="10" Foreground="LightGreen"/>
                                                    <TextBlock Text=" | 😊 " FontSize="10" Margin="10,0,0,0"/>
                                                    <TextBlock Text="{Binding Morale}" FontSize="10" Foreground="Pink"/>
                                                </StackPanel>
                                                
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="💰 $" FontSize="10" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding Salary, StringFormat=N0}" FontSize="10" Foreground="LightGreen"/>
                                                    <TextBlock Text="/month | ⚠️ " FontSize="10" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding RiskLevel}" FontSize="10" Foreground="Orange"/>
                                                </StackPanel>
                                            </StackPanel>
                                            
                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Top">
                                                <Button Content="➕ Assign" MinWidth="80" Height="28" Padding="8,0"
                                                       Background="#2a4d3a" Foreground="White" BorderBrush="#4d7a5d"
                                                       Click="AssignBtn_Click" Tag="{Binding}" Margin="0,0,0,5"/>
                                                <Button Content="🔥 Fire" MinWidth="80" Height="28" Padding="8,0"
                                                       Background="#8b2635" Foreground="White" BorderBrush="#b83545"
                                                       Click="FireBtn_Click" Tag="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Bottom Controls -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="CloseBtn" Content="Close" Width="100" Height="40" 
                    Click="CloseBtn_Click"/>
        </StackPanel>
    </Grid>
    </Grid>
    </Border>
</Window>