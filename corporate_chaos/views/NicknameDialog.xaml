<Window x:Class="CorporateChaos.Views.NicknameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter Your Nickname" Height="280" Width="420" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Border Background="#1a1a2e" CornerRadius="12" BorderBrush="#2a3a5e" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Custom Title Bar -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1e2e4e" Offset="0"/>
                        <GradientStop Color="#162040" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <TextBlock Text="🎯 GAME OVER" FontSize="14" FontWeight="Bold" 
                              Foreground="White" VerticalAlignment="Center" Margin="15,0,0,0"/>
                </Grid>
            </Border>
            
            <!-- Content -->
            <Grid Grid.Row="1" Margin="20,10,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="🎯 Game Over!" FontSize="24" FontWeight="Bold" 
                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        
        <TextBlock Grid.Row="1" x:Name="ScoreText" Text="Your Score: 0" FontSize="16" 
                   Foreground="LightBlue" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        
        <TextBlock Grid.Row="2" Text="Enter your nickname for the leaderboard:" FontSize="14" 
                   Foreground="White" Margin="0,0,0,10"/>
        
        <TextBox Grid.Row="3" x:Name="NicknameTextBox" FontSize="16" Height="35" 
                 MaxLength="20" Margin="0,0,0,20" 
                 KeyDown="NicknameTextBox_KeyDown"/>
        
        <TextBlock Grid.Row="4" x:Name="ValidationText" Text="" FontSize="12" 
                   Foreground="Orange" Margin="0,0,0,10" TextWrapping="Wrap"/>
        
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="OkButton" Content="Save Score" Width="100" Height="35" 
                    Margin="0,0,10,0" Click="OkButton_Click" IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Skip" Width="100" Height="35" 
                    Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
    </Grid>
    </Border>
</Window>