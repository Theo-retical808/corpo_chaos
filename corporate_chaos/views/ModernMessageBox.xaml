<Window x:Class="CorporateChaos.Views.ModernMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" Height="Auto" Width="500" 
        WindowStyle="None" AllowsTransparency="True" 
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/styles/Typography.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Border Background="#1a1a2e" BorderBrush="#4a4a6e" BorderThickness="2" CornerRadius="12"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.6" BlurRadius="20" ShadowDepth="0"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header with Icon -->
            <Border Grid.Row="0" x:Name="HeaderBorder" Background="#2a2a4e" 
                    CornerRadius="10,10,0,0" Padding="25,20">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock x:Name="IconText" Text="ℹ️" FontSize="28" 
                                  VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <TextBlock x:Name="TitleText" Text="Information" 
                                  Style="{StaticResource HeaderMedium}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Content -->
            <Border Grid.Row="1" Padding="30,25">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                    <TextBlock x:Name="MessageText" Text="Message content goes here" 
                              Style="{StaticResource BodyLarge}"
                              TextWrapping="Wrap" LineHeight="22"/>
                </ScrollViewer>
            </Border>
            
            <!-- Buttons -->
            <Border Grid.Row="2" Background="#16213e" 
                    CornerRadius="0,0,10,10" Padding="25,20">
                <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" 
                           HorizontalAlignment="Right">
                    <!-- Buttons will be added dynamically -->
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
