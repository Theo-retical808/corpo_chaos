<Window x:Class="CorporateChaos.Views.StoryModeGuide"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Secretary Joan - Your Corporate Guide" Height="600" Width="850" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1a1a2e">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/styles/ScrollBarStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>
        
        <!-- Main Content Area -->
        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header with Joan's Info -->
            <Border Grid.Row="0" Background="#16213e" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Joan's Avatar -->
                    <Border Grid.Column="0" Width="80" Height="80" CornerRadius="40" 
                           Background="White" Margin="0,0,15,0">
                        <Image x:Name="JoanAvatarImage" Width="70" Height="70" 
                              Stretch="UniformToFill" ClipToBounds="True">
                            <Image.Clip>
                                <EllipseGeometry Center="35,35" RadiusX="35" RadiusY="35"/>
                            </Image.Clip>
                        </Image>
                    </Border>
                    
                    <!-- Joan's Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Secretary Joan" FontSize="20" FontWeight="Bold" 
                                  Foreground="White" Margin="0,0,0,5"/>
                        <TextBlock x:Name="RoleText" Text="Your Personal Corporate Assistant" 
                                  FontSize="14" Foreground="LightBlue"/>
                        <TextBlock x:Name="QuarterText" Text="Quarter 1 - Tutorial Phase" 
                                  FontSize="12" Foreground="LightGray" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Story Event Title -->
            <Border Grid.Row="1" Background="#2a2a4d" CornerRadius="10" Padding="20" Margin="0,0,0,15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource CorporateChaosScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <TextBlock x:Name="EventTitleText" Text="Welcome to Your New Company!" 
                                  FontSize="18" FontWeight="Bold" Foreground="White" 
                                  Margin="0,0,0,15" TextWrapping="Wrap"/>
                        
                        <TextBlock x:Name="EventDescriptionText" 
                                  Text="You've just taken over MidCorp Industries, a mid-sized manufacturing company..."
                                  FontSize="14" Foreground="LightGray" Margin="0,0,0,20" TextWrapping="Wrap"/>
                        
                        <!-- Joan's Dialogue -->
                        <Border Background="#16213e" CornerRadius="8" Padding="15">
                            <StackPanel>
                                <TextBlock Text="💬 Joan says:" FontSize="14" FontWeight="Bold" 
                                          Foreground="LightBlue" Margin="0,0,0,10"/>
                                <TextBlock x:Name="DialogueText" 
                                          Text="Hello! I'm Secretary Joan, your personal assistant..."
                                          FontSize="13" Foreground="White" TextWrapping="Wrap" 
                                          LineHeight="20"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Current Objective -->
            <Border Grid.Row="2" Background="#2a4d3a" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="🎯 Current Objective:" FontSize="14" FontWeight="Bold" 
                              Foreground="White" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ObjectiveText" 
                              Text="Learn the basic company stats and end your first quarter"
                              FontSize="13" Foreground="LightGreen" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            
            <!-- Navigation Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="PrevDialogueBtn" Content="← Previous" Width="100" Height="35" 
                        Margin="0,0,15,0" Click="PrevDialogueBtn_Click" IsEnabled="False"/>
                <Button x:Name="NextDialogueBtn" Content="Next →" Width="100" Height="35" 
                        Margin="0,0,15,0" Click="NextDialogueBtn_Click"/>
                <Button x:Name="CloseBtn" Content="Got it!" Width="100" Height="35" 
                        Click="CloseBtn_Click" Background="#2a4d3a" Foreground="White"/>
            </StackPanel>
        </Grid>
        
        <!-- Right Sidebar - Story Progress & Character Relationships -->
        <Border Grid.Column="1" Background="#16213e" CornerRadius="10" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource CorporateChaosScrollBar}"/>
                </ScrollViewer.Resources>
                <StackPanel>
                    <!-- Story Progress Section -->
                    <TextBlock Text="📖 Story Progress" FontSize="16" FontWeight="Bold" 
                              Foreground="White" Margin="0,0,0,10"/>
                    
                    <!-- Current Act -->
                    <Border Background="#2a2a4d" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Current Act:" FontSize="12" Foreground="LightGray" Margin="0,0,0,5"/>
                            <TextBlock x:Name="CurrentActText" Text="Act I: Tutorial" 
                                      FontSize="14" FontWeight="Bold" Foreground="LightBlue"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Act Progress Bar -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock x:Name="ActProgressText" Text="Progress: 10%" 
                                  FontSize="11" Foreground="LightGray" Margin="0,0,0,5"/>
                        <Border Background="#1a1a2e" CornerRadius="3" Height="8">
                            <Border x:Name="ActProgressBar" Background="#4a9eff" 
                                   CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                        </Border>
                    </StackPanel>
                    
                    <!-- Character Relationships Section -->
                    <TextBlock Text="👥 Relationships" FontSize="16" FontWeight="Bold" 
                              Foreground="White" Margin="0,10,0,10"/>
                    
                    <!-- Character List Container -->
                    <StackPanel x:Name="CharacterRelationshipsPanel">
                        <!-- Characters will be added dynamically -->
                    </StackPanel>
                    
                    <!-- Story Statistics -->
                    <TextBlock Text="📊 Statistics" FontSize="16" FontWeight="Bold" 
                              Foreground="White" Margin="0,20,0,10"/>
                    
                    <Border Background="#2a2a4d" CornerRadius="5" Padding="10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Choices Made: " FontSize="12" Foreground="LightGray"/>
                                <TextBlock x:Name="ChoiceCountText" Text="0" FontSize="12" 
                                          FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Events Seen: " FontSize="12" Foreground="LightGray"/>
                                <TextBlock x:Name="EventCountText" Text="0" FontSize="12" 
                                          FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Characters Met: " FontSize="12" Foreground="LightGray"/>
                                <TextBlock x:Name="CharacterCountText" Text="1/9" FontSize="12" 
                                          FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>