<Window x:Class="CorporateChaos.Views.JoanDialogue"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Secretary Joan - Your Assistant" Height="500" Width="700" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/styles/ScrollBarStyles.xaml"/>
                <ResourceDictionary Source="/styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/styles/Typography.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Border Background="#1a1a2e" BorderBrush="#4a4a6e" BorderThickness="2" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="20" ShadowDepth="0"/>
        </Border.Effect>
        
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header with Joan's Info -->
            <Border Grid.Row="0" Background="#2a4a6e" CornerRadius="10,10,0,0" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Joan's Avatar with Glow -->
                    <Border Grid.Column="0" Width="70" Height="70" 
                           Background="White" CornerRadius="35" Margin="0,0,20,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#4a7c9e" Opacity="0.6" BlurRadius="15" ShadowDepth="0"/>
                        </Border.Effect>
                        <Image x:Name="JoanDialogueAvatar" Width="66" Height="66" 
                              Stretch="UniformToFill" ClipToBounds="True">
                            <Image.Clip>
                                <EllipseGeometry Center="33,33" RadiusX="33" RadiusY="33"/>
                            </Image.Clip>
                        </Image>
                    </Border>
                    
                    <!-- Joan's Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="CharacterNameText" Text="Secretary Joan" Style="{StaticResource HeaderMedium}" 
                                  Margin="0,0,0,5"/>
                        <TextBlock x:Name="JoanRoleText" Text="Your Personal Corporate Assistant" 
                                  Style="{StaticResource BodyMedium}" Foreground="#B0D4F1"/>
                        <TextBlock x:Name="JoanStatusText" Text="Ready to help!" 
                                  Style="{StaticResource Caption}" Foreground="#90B4D1" Margin="0,5,0,0"/>
                    </StackPanel>
                    
                    <!-- Close Button -->
                    <Button Grid.Column="2" x:Name="CloseDialogueBtn" Content="✕" 
                            Click="CloseDialogueBtn_Click" 
                            Style="{StaticResource CloseButton}"/>
                </Grid>
            </Border>
            
            <!-- Joan's Dialogue Content -->
            <Border Grid.Row="1" Background="#16213e" Padding="25,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource CorporateChaosScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <!-- Dialogue Text with Speech Bubble Effect -->
                        <Border Background="#2a3a5e" CornerRadius="12" Padding="20" Margin="0,0,0,15">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="8" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="💬" FontSize="20" Margin="0,0,8,0"/>
                                    <TextBlock Text="Joan says:" Style="{StaticResource HeaderSmall}" 
                                              Foreground="#B0D4F1"/>
                                </StackPanel>
                                <TextBlock x:Name="JoanDialogueText" 
                                          Text="Hello! I'm here to help you manage your company effectively..."
                                          Style="{StaticResource BodyLarge}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Situation Analysis with Icon -->
                        <Border Background="#2a4d3a" CornerRadius="10" Padding="18" Margin="0,0,0,15">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="8" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="📊" FontSize="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="Current Situation" Style="{StaticResource HeaderSmall}" 
                                              Foreground="#B0F1C0"/>
                                </StackPanel>
                                <TextBlock x:Name="SituationAnalysisText" 
                                          Text="Analyzing your company's current state..."
                                          Style="{StaticResource BodyMedium}" TextWrapping="Wrap" 
                                          Foreground="#E0F0E0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Recommendations with Icon -->
                        <Border Background="#4d2a4d" CornerRadius="10" Padding="18">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="8" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="💡" FontSize="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="My Recommendations" Style="{StaticResource HeaderSmall}" 
                                              Foreground="#F1B0D4"/>
                                </StackPanel>
                                <TextBlock x:Name="RecommendationsText" 
                                          Text="Based on your situation, here's what I suggest..."
                                          Style="{StaticResource BodyMedium}" TextWrapping="Wrap" 
                                          Foreground="#F0E0F0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Branching Conversation Choices Panel -->
            <Border x:Name="BranchingChoicesPanel" Grid.Row="2" Background="#1a1a2e" 
                    CornerRadius="0,0,10,10" Padding="20,15" Visibility="Collapsed">
                <StackPanel>
                    <!-- Choice Instructions -->
                    <TextBlock Text="💭 How would you like to respond?" 
                              Style="{StaticResource HeaderSmall}" Foreground="#B0D4F1"
                              Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    
                    <!-- Dynamic Choice Buttons Container -->
                    <StackPanel x:Name="ChoiceButtonsContainer" Orientation="Vertical"/>
                </StackPanel>
            </Border>
            
            <!-- Traditional Action Buttons (Legacy Mode) -->
            <Border x:Name="TraditionalButtonsPanel" Grid.Row="2" Background="#16213e" 
                    CornerRadius="0,0,10,10" Padding="20,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="GetAdviceBtn" Content="🎯 Get Strategic Advice" 
                            MinWidth="160" Height="40" Margin="0,0,10,0" 
                            Click="GetAdviceBtn_Click" Style="{StaticResource PrimaryButton}"/>
                    
                    <Button x:Name="CheckRemindersBtn" Content="⏰ Check Reminders" 
                            MinWidth="140" Height="40" Margin="0,0,10,0" 
                            Click="CheckRemindersBtn_Click" Style="{StaticResource SecondaryButton}"/>
                    
                    <Button x:Name="DismissBtn" Content="Thanks Joan!" 
                            MinWidth="120" Height="40" 
                            Click="DismissBtn_Click" Style="{StaticResource GhostButton}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
