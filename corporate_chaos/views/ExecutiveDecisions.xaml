<Window x:Class="CorporateChaos.Views.ExecutiveDecisions"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Executive Strategic Decisions" Height="800" Width="1200" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Border Background="#1a1a2e" CornerRadius="12" BorderBrush="#2a3a5e" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Custom Title Bar -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1e2e4e" Offset="0"/>
                        <GradientStop Color="#162040" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <TextBlock Text="🎯 EXECUTIVE STRATEGIC DECISIONS" FontSize="14" FontWeight="Bold" 
                              Foreground="White" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    <Button Content="✕" Width="36" Height="28" HorizontalAlignment="Right" Margin="0,0,8,0"
                            Click="CloseBtn_Click" Style="{StaticResource CloseButton}"/>
                </Grid>
            </Border>
            
            <!-- Content -->
            <Grid Grid.Row="1" Margin="20,10,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="CompanyStatusText" Text="Make strategic decisions to improve company performance" 
                      FontSize="12" Foreground="LightGray" HorizontalAlignment="Center"/>
        </StackPanel>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Financial Decisions -->
            <Border Grid.Column="0" Background="#16213e" Padding="18" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="💰 FINANCIAL DECISIONS" FontSize="16" FontWeight="Bold" 
                              Foreground="White" Margin="0,0,0,15"/>
                    
                    <!-- Cost Cutting -->
                    <Border Background="#2a2a4d" Padding="15" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="✂️ Cost Cutting" FontSize="14" FontWeight="Bold" 
                                      Foreground="White" Margin="0,0,0,5"/>
                            <TextBlock Text="Reduce expenses, impact morale" FontSize="11" 
                                      Foreground="LightGray" Margin="0,0,0,8"/>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="CostCuttingLightBtn" Content="Light 5%" MinWidth="75" Height="32" 
                                       Margin="2" Click="CostCuttingLight_Click" 
                                       Background="#4d2a2a" Foreground="White"
                                       BorderThickness="0" FontSize="11" FontWeight="SemiBold" Padding="6,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#4d2a2a"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#6d3a3a"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button x:Name="CostCuttingMediumBtn" Content="Med 15%" MinWidth="75" Height="32" 
                                       Margin="2" Click="CostCuttingMedium_Click" 
                                       Background="#4d2a2a" Foreground="White"
                                       BorderThickness="0" FontSize="11" FontWeight="SemiBold" Padding="6,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#4d2a2a"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#6d3a3a"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button x:Name="CostCuttingHeavyBtn" Content="Heavy 25%" MinWidth="80" Height="32" 
                                       Margin="2" Click="CostCuttingHeavy_Click" 
                                       Background="#4d2a2a" Foreground="White"
                                       BorderThickness="0" FontSize="11" FontWeight="SemiBold" Padding="6,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#4d2a2a"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#6d3a3a"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Employee Bonuses -->
                    <Border Background="#2a2a4d" Padding="15" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🎁 Employee Bonuses" FontSize="14" FontWeight="Bold" 
                                      Foreground="White" Margin="0,0,0,5"/>
                            <TextBlock Text="Boost morale and productivity" FontSize="11" 
                                      Foreground="LightGray" Margin="0,0,0,8"/>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="BonusSmallBtn" Content="Small $50K" MinWidth="95" Height="32" 
                                       Margin="5,0" Click="BonusSmall_Click" 
                                       Background="#2a4d3a" Foreground="White"
                                       BorderThickness="0" FontSize="11" FontWeight="SemiBold" Padding="6,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#2a4d3a"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#3a6d4a"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button x:Name="BonusLargeBtn" Content="Large $150K" MinWidth="100" Height="32" 
                                       Margin="5,0" Click="BonusLarge_Click" 
                                       Background="#2a4d3a" Foreground="White"
                                       BorderThickness="0" FontSize="11" FontWeight="SemiBold" Padding="6,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#2a4d3a"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#3a6d4a"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Business Loans -->
                    <Border Background="#2a2a4d" Padding="15">
                        <StackPanel>
                            <TextBlock Text="🏦 Business Loans" FontSize="14" FontWeight="Bold" 
                                      Foreground="White" Margin="0,0,0,5"/>
                            <TextBlock Text="Choose your financing option" FontSize="11" 
                                      Foreground="LightGray" Margin="0,0,0,8"/>
                            
                            <!-- Small Loan -->
                            <Button x:Name="SmallLoanBtn" Content="Small Loan $100K" MinWidth="150" Height="28" 
                                   Click="SmallLoan_Click" HorizontalAlignment="Center" Margin="0,2"
                                   Background="#4d4d2a" Foreground="White"
                                   BorderThickness="0" FontSize="10" FontWeight="SemiBold" Padding="8,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#4d4d2a"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#6d6d3a"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            
                            <!-- Medium Loan -->
                            <Button x:Name="MediumLoanBtn" Content="Medium Loan $500K" MinWidth="155" Height="28" 
                                   Click="MediumLoan_Click" HorizontalAlignment="Center" Margin="0,2"
                                   Background="#4d4d2a" Foreground="White"
                                   BorderThickness="0" FontSize="10" FontWeight="SemiBold" Padding="8,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#4d4d2a"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#6d6d3a"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            
                            <!-- Large Loan -->
                            <Button x:Name="LargeLoanBtn" Content="Large Loan $1M" MinWidth="140" Height="28" 
                                   Click="LargeLoan_Click" HorizontalAlignment="Center" Margin="0,2"
                                   Background="#4d4d2a" Foreground="White"
                                   BorderThickness="0" FontSize="10" FontWeight="SemiBold" Padding="8,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#4d4d2a"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#6d6d3a"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            
            <!-- Strategic Decisions -->
            <Border Grid.Column="1" Background="#16213e" Padding="18" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="📈 STRATEGIC DECISIONS" FontSize="16" FontWeight="Bold" 
                              Foreground="White" Margin="0,0,0,15"/>
                    
                    <!-- Marketing Campaign -->
                    <Border Background="#2a2a4d" Padding="15" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="📢 Marketing Campaign" FontSize="14" FontWeight="Bold" 
                                      Foreground="White" Margin="0,0,0,5"/>
                            <TextBlock Text="Boost reputation &amp; market share" FontSize="11" 
                                      Foreground="LightGray" Margin="0,0,0,8"/>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="MarketingLocalBtn" Content="Local $100K" MinWidth="95" Height="32" 
                                       Margin="5,0" Click="MarketingLocal_Click" 
                                       Background="#2a4d4d" Foreground="White"
                                       BorderThickness="0" FontSize="11" FontWeight="SemiBold" Padding="6,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#2a4d4d"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#3a6d6d"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button x:Name="MarketingNationalBtn" Content="National $275K" MinWidth="110" Height="32" 
                                       Margin="5,0" Click="MarketingNational_Click" 
                                       Background="#2a4d4d" Foreground="White"
                                       BorderThickness="0" FontSize="11" FontWeight="SemiBold" Padding="6,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#2a4d4d"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#3a6d6d"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- Company Retreat -->
                    <Border Background="#2a2a4d" Padding="15" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🏖️ Company Retreat" FontSize="14" FontWeight="Bold" 
                                      Foreground="White" Margin="0,0,0,5"/>
                            <TextBlock Text="Team building &amp; morale boost" FontSize="11" 
                                      Foreground="LightGray" Margin="0,0,0,8"/>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="RetreatWeekendBtn" Content="Weekend" MinWidth="85" Height="32" 
                                       Margin="5,0" Click="RetreatWeekend_Click" 
                                       Background="#2a4d3a" Foreground="White"
                                       BorderThickness="0" FontSize="11" FontWeight="SemiBold" Padding="8,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#2a4d3a"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#3a6d4a"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button x:Name="RetreatWeekBtn" Content="Week" MinWidth="85" Height="32" 
                                       Margin="5,0" Click="RetreatWeek_Click" 
                                       Background="#2a4d3a" Foreground="White"
                                       BorderThickness="0" FontSize="11" FontWeight="SemiBold" Padding="8,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#2a4d3a"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#3a6d4a"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- R&D Investment -->
                    <Border Background="#2a2a4d" Padding="15">
                        <StackPanel>
                            <TextBlock Text="🔬 R&amp;D Investment" FontSize="14" FontWeight="Bold" 
                                      Foreground="White" Margin="0,0,0,5"/>
                            <TextBlock Text="Innovation &amp; future growth" FontSize="11" 
                                      Foreground="LightGray" Margin="0,0,0,8"/>
                            
                            <Button x:Name="RDInvestmentBtn" Content="Major Investment $120K" MinWidth="170" Height="32" 
                                   Click="RDInvestment_Click" HorizontalAlignment="Center"
                                   Background="#4d2a4d" Foreground="White"
                                   BorderThickness="0" FontSize="11" FontWeight="SemiBold" Padding="8,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#4d2a4d"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#6d3a6d"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            
            <!-- Management Decisions -->
            <Border Grid.Column="2" Background="#16213e" Padding="18" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="🎯 MANAGEMENT DECISIONS" FontSize="16" FontWeight="Bold" 
                              Foreground="White" Margin="0,0,0,15"/>
                    
                    <!-- Crisis Management -->
                    <Border Background="#2a2a4d" Padding="15" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🚨 Crisis Management" FontSize="14" FontWeight="Bold" 
                                      Foreground="White" Margin="0,0,0,5"/>
                            <TextBlock Text="Hire consultants for crises" FontSize="11" 
                                      Foreground="LightGray" Margin="0,0,0,8"/>
                            
                            <Button x:Name="CrisisManagementBtn" Content="Hire Consultants $100K" MinWidth="175" Height="32" 
                                   Click="CrisisManagement_Click" HorizontalAlignment="Center"
                                   Background="#4d3a2a" Foreground="White"
                                   BorderThickness="0" FontSize="11" FontWeight="SemiBold" Padding="8,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#4d3a2a"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#6d5a3a"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                    
                    <!-- Quick Actions -->
                    <Border Background="#2a2a4d" Padding="15">
                        <StackPanel>
                            <TextBlock Text="⚡ Quick Actions" FontSize="14" FontWeight="Bold" 
                                      Foreground="White" Margin="0,0,0,5"/>
                            <TextBlock Text="Fast strategic moves" FontSize="11" 
                                      Foreground="LightGray" Margin="0,0,0,8"/>
                            
                            <Button Content="🎯 Executive Meeting" MinWidth="160" Height="32" 
                                   HorizontalAlignment="Center" Margin="0,0,0,8"
                                   Background="#3a3a5d" Foreground="White" Padding="8,0"
                                   BorderThickness="0" FontSize="11" FontWeight="SemiBold">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#3a3a5d"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#4a4a7d"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            
                            <Button Content="📊 Market Analysis" MinWidth="160" Height="32" 
                                   HorizontalAlignment="Center" Padding="8,0"
                                   Background="#3a3a5d" Foreground="White"
                                   BorderThickness="0" FontSize="11" FontWeight="SemiBold">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#3a3a5d"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#4a4a7d"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Department Budget Allocation - Compact -->
        <Border Grid.Row="2" Background="#16213e" Padding="15" Margin="0,15,0,0">
            <StackPanel>
                <TextBlock Text="📊 DEPARTMENT BUDGET ALLOCATION" FontSize="16" FontWeight="Bold" 
                          Foreground="White" Margin="0,0,0,12"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Compact Budget Sliders -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="📢 Marketing" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                        <Slider x:Name="MarketingBudgetSlider" Minimum="0" Maximum="40" Value="15" 
                               TickFrequency="5" IsSnapToTickEnabled="True" Orientation="Vertical" 
                               Height="60" HorizontalAlignment="Center" Margin="0,3,0,3"/>
                        <TextBlock x:Name="MarketingBudgetText" Text="15%" FontSize="10" 
                                  Foreground="LightGray" HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="⚙️ Operations" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                        <Slider x:Name="OperationsBudgetSlider" Minimum="0" Maximum="40" Value="20" 
                               TickFrequency="5" IsSnapToTickEnabled="True" Orientation="Vertical" 
                               Height="60" HorizontalAlignment="Center" Margin="0,3,0,3"/>
                        <TextBlock x:Name="OperationsBudgetText" Text="20%" FontSize="10" 
                                  Foreground="LightGray" HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="💰 Finance" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                        <Slider x:Name="FinanceBudgetSlider" Minimum="0" Maximum="40" Value="15" 
                               TickFrequency="5" IsSnapToTickEnabled="True" Orientation="Vertical" 
                               Height="60" HorizontalAlignment="Center" Margin="0,3,0,3"/>
                        <TextBlock x:Name="FinanceBudgetText" Text="15%" FontSize="10" 
                                  Foreground="LightGray" HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="👥 HR" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                        <Slider x:Name="HRBudgetSlider" Minimum="0" Maximum="40" Value="10" 
                               TickFrequency="5" IsSnapToTickEnabled="True" Orientation="Vertical" 
                               Height="60" HorizontalAlignment="Center" Margin="0,3,0,3"/>
                        <TextBlock x:Name="HRBudgetText" Text="10%" FontSize="10" 
                                  Foreground="LightGray" HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="4" Margin="0,0,8,0">
                        <TextBlock Text="💻 IT" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                        <Slider x:Name="ITBudgetSlider" Minimum="0" Maximum="40" Value="20" 
                               TickFrequency="5" IsSnapToTickEnabled="True" Orientation="Vertical" 
                               Height="60" HorizontalAlignment="Center" Margin="0,3,0,3"/>
                        <TextBlock x:Name="ITBudgetText" Text="20%" FontSize="10" 
                                  Foreground="LightGray" HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="5" Margin="0,0,8,0">
                        <TextBlock Text="🔬 Research" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                        <Slider x:Name="ResearchBudgetSlider" Minimum="0" Maximum="40" Value="20" 
                               TickFrequency="5" IsSnapToTickEnabled="True" Orientation="Vertical" 
                               Height="60" HorizontalAlignment="Center" Margin="0,3,0,3"/>
                        <TextBlock x:Name="ResearchBudgetText" Text="20%" FontSize="10" 
                                  Foreground="LightGray" HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="6" VerticalAlignment="Center">
                        <TextBlock x:Name="TotalBudgetText" Text="Total: 100%" FontSize="12" FontWeight="Bold" 
                                  Foreground="White" Margin="10,0,0,8"/>
                        <Button x:Name="ApplyBudgetBtn" Content="Apply Budget" MinWidth="110" Height="35" 
                               Click="ApplyBudget_Click" Background="#2a4d3a" Foreground="White" 
                               BorderThickness="0" FontWeight="SemiBold" Padding="10,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#2a4d3a"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#3a6d4a"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
    </Border>
</Window>