<Window x:Class="CorporateChaos.Views.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚙️ Options" Height="450" Width="600" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1a1a2e">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/styles/ScrollBarStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="⚙️ GAME OPTIONS" 
                   FontSize="24" FontWeight="Bold" 
                   Foreground="White" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,30"/>

        <!-- Options Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource CorporateChaosScrollBar}"/>
            </ScrollViewer.Resources>
            <StackPanel>
            
                <!-- Audio Section -->
            <Border Background="#16213e" 
                    BorderBrush="#333" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="20"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="🔊 AUDIO SETTINGS" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               Margin="0,0,0,15"/>
                    
                    <!-- Volume Control -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" 
                                   Text="Volume:" 
                                   FontSize="14" 
                                   Foreground="LightGray" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,15,0"/>
                        
                        <Slider Grid.Column="1" 
                                x:Name="VolumeSlider" 
                                Minimum="0" 
                                Maximum="100" 
                                Value="30" 
                                TickFrequency="10" 
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                        
                        <TextBlock Grid.Column="2" 
                                   x:Name="VolumePercentText" 
                                   Text="30%" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   VerticalAlignment="Center" 
                                   Margin="15,0,0,0" 
                                   Width="45"/>
                    </Grid>
                    
                    <!-- Mute Toggle -->
                    <CheckBox x:Name="MuteCheckBox" 
                              Content="Mute Audio" 
                              FontSize="14" 
                              Foreground="LightGray"
                              Checked="MuteCheckBox_Changed"
                              Unchecked="MuteCheckBox_Changed"/>
                </StackPanel>
            </Border>

            <!-- Display Section -->
            <Border Background="#16213e" 
                    BorderBrush="#333" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="🖥️ DISPLAY SETTINGS" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               Margin="0,0,0,15"/>
                    
                    <!-- Display Mode -->
                    <StackPanel>
                        <TextBlock Text="Display Mode:" 
                                   FontSize="14" 
                                   Foreground="LightGray" 
                                   Margin="0,0,0,10"/>
                        
                        <RadioButton x:Name="WindowedModeRadio" 
                                     Content="Windowed Mode" 
                                     FontSize="14" 
                                     Foreground="LightGray" 
                                     GroupName="DisplayMode"
                                     IsChecked="True"
                                     Margin="0,0,0,8"
                                     Checked="DisplayMode_Changed"/>
                        
                        <RadioButton x:Name="FullscreenModeRadio" 
                                     Content="Fullscreen Mode" 
                                     FontSize="14" 
                                     Foreground="LightGray" 
                                     GroupName="DisplayMode"
                                     Checked="DisplayMode_Changed"/>
                        
                        <TextBlock Text="Note: Display mode changes will apply immediately" 
                                   FontSize="11" 
                                   Foreground="Gray" 
                                   FontStyle="Italic" 
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,20,0,0">
            <Button x:Name="ApplyBtn" 
                    Content="✓ Apply" 
                    Width="120" 
                    Height="40" 
                    FontSize="16" 
                    Margin="0,0,15,0"
                    Click="ApplyBtn_Click"/>
            <Button x:Name="CloseBtn" 
                    Content="Close" 
                    Width="120" 
                    Height="40" 
                    FontSize="16"
                    Click="CloseBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
