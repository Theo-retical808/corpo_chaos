<Window x:Class="CorporateChaos.Views.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options" Height="450" Width="600" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/styles/ScrollBarStyles.xaml"/>
                <ResourceDictionary Source="/styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/styles/GameTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Border Background="#1a1a2e" CornerRadius="12" BorderBrush="#2a3a5e" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Custom Title Bar -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1e2e4e" Offset="0"/>
                        <GradientStop Color="#162040" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <TextBlock Text="⚙️ GAME OPTIONS" FontSize="14" FontWeight="Bold" 
                              Foreground="White" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    <Button Content="✕" Width="36" Height="28" HorizontalAlignment="Right" Margin="0,0,8,0"
                            Click="CloseBtn_Click" Style="{StaticResource CloseButton}"/>
                </Grid>
            </Border>
            
            <!-- Content -->
            <Grid Grid.Row="1" Margin="20,10,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

        <!-- Options Content -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource CorporateChaosScrollBar}"/>
            </ScrollViewer.Resources>
            <StackPanel>
            
                <!-- Audio Section -->
            <Border Background="#16213e" 
                    BorderBrush="#333" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="20"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="🔊 AUDIO SETTINGS" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               Margin="0,0,0,15"/>
                    
                    <!-- Volume Control -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" 
                                   Text="Volume:" 
                                   FontSize="14" 
                                   Foreground="LightGray" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,15,0"/>
                        
                        <Slider Grid.Column="1" 
                                x:Name="VolumeSlider" 
                                Minimum="0" 
                                Maximum="100" 
                                Value="30" 
                                TickFrequency="10" 
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                        
                        <TextBlock Grid.Column="2" 
                                   x:Name="VolumePercentText" 
                                   Text="30%" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   VerticalAlignment="Center" 
                                   Margin="15,0,0,0" 
                                   Width="45"/>
                    </Grid>
                    
                    <!-- Mute Toggle -->
                    <CheckBox x:Name="MuteCheckBox" 
                              Content="Mute Audio" 
                              FontSize="14" 
                              Foreground="LightGray"
                              Checked="MuteCheckBox_Changed"
                              Unchecked="MuteCheckBox_Changed"/>
                </StackPanel>
            </Border>

            <!-- Display Section -->
            <Border Background="#16213e" 
                    BorderBrush="#333" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="🖥️ DISPLAY SETTINGS" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               Margin="0,0,0,15"/>
                    
                    <!-- Display Mode -->
                    <StackPanel>
                        <TextBlock Text="Display Mode:" 
                                   FontSize="14" 
                                   Foreground="LightGray" 
                                   Margin="0,0,0,10"/>
                        
                        <RadioButton x:Name="WindowedModeRadio" 
                                     Content="Windowed Mode" 
                                     FontSize="14" 
                                     Foreground="LightGray" 
                                     GroupName="DisplayMode"
                                     IsChecked="True"
                                     Margin="0,0,0,8"
                                     Checked="DisplayMode_Changed"/>
                        
                        <RadioButton x:Name="FullscreenModeRadio" 
                                     Content="Fullscreen Mode" 
                                     FontSize="14" 
                                     Foreground="LightGray" 
                                     GroupName="DisplayMode"
                                     Checked="DisplayMode_Changed"/>
                        
                        <TextBlock Text="Note: Display mode changes will apply immediately" 
                                   FontSize="11" 
                                   Foreground="Gray" 
                                   FontStyle="Italic" 
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,20,0,0">
            <Button x:Name="ApplyBtn" 
                    Content="✓ Apply" 
                    Width="120" 
                    Height="40" 
                    FontSize="16" 
                    Margin="0,0,15,0"
                    Click="ApplyBtn_Click"/>
            <Button x:Name="CloseBtn" 
                    Content="Close" 
                    Width="120" 
                    Height="40" 
                    FontSize="16"
                    Click="CloseBtn_Click"/>
        </StackPanel>
    </Grid>
    </Grid>
    </Border>
</Window>