<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <Product>Corporate Chaos</Product>
    <Description>Corporate Chaos v1.4 — Interactive tutorial system, dialogue variety, and UX improvements.</Description>
    <PackageReleaseNotes>
      v1.4 Patch Notes:
      - Interactive tutorial: highlights now follow what Joan is saying and auto-advance when you click the correct button. No more manual "Next" clicking during guided steps.
      - Tutorial always on top: dialogue overlay renders above all game panels including hiring and executive decision windows.
      - Smooth tutorial flow: eliminated dead spots where players had no prompt. Clear "Next" buttons for context steps, auto-advance for action steps.
      - Removed hire alert popup: hiring is now seamless without interrupting MessageBox confirmations.
      - Dialogue variety: expanded Joan's dialogue pool from 3-5 to 12 unique lines per relationship phase with repetition prevention.
      - Dialogue never repeats: tracking system ensures every line is shown before any can repeat.
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="images\logo.png" />
    <Resource Include="images\marketing.png" />
    <Resource Include="images\operations.png" />
    <Resource Include="images\finance.png" />
    <Resource Include="images\human_resources.png" />
    <Resource Include="images\it.png" />
    <Resource Include="images\research.png" />
    <Resource Include="images\assistant.png" />
    <Resource Include="images\char\*.png" />
    <Resource Include="images\emp_male\*.png" />
    <Resource Include="images\emp_female\*.png" />
    <Resource Include="audio\background.mp3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="audio\background.mp3">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="data\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
