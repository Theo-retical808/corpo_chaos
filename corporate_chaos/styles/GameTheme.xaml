<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- GAME MENU BUTTON - Polished main menu style        -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="GameMenuButton" TargetType="Button">
        <Setter Property="Background" Value="#2a3a5e"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="55"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" CornerRadius="8" 
                            BorderThickness="1" BorderBrush="#3a4a6e"
                            Padding="20,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#2a3a5e" Offset="0"/>
                                <GradientStop Color="#1e2e4e" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3a5a8e" Offset="0"/>
                                        <GradientStop Color="#2a4a7e" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#5a7aae"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1a2a4e" Offset="0"/>
                                        <GradientStop Color="#0e1e3e" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Game Menu Danger Button (Quit) -->
    <Style x:Key="GameMenuDangerButton" TargetType="Button" BasedOn="{StaticResource GameMenuButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" CornerRadius="8" 
                            BorderThickness="1" BorderBrush="#5e3a3a"
                            Padding="20,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#4d2a2a" Offset="0"/>
                                <GradientStop Color="#3d1a1a" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#6d3a3a" Offset="0"/>
                                        <GradientStop Color="#5d2a2a" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#8e5a5a"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- STAT BAR - Horizontal progress bar for stats       -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="StatProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Background" Value="#1a1a2e"/>
        <Setter Property="Foreground" Value="#4a7c59"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" 
                                CornerRadius="4"/>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" 
                                CornerRadius="4" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- GAME PANEL - Styled container for game sections    -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="GamePanel" TargetType="Border">
        <Setter Property="Background" Value="#16213e"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderBrush" Value="#2a3a5e"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- HEADER BAR - Top bar styling                       -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="HeaderBar" TargetType="Border">
        <Setter Property="BorderBrush" Value="#2a3a5e"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1a1a2e" Offset="0"/>
                    <GradientStop Color="#141428" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- SIDEBAR CONTROL BUTTON - Executive control buttons -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="ControlKnobButton" TargetType="Button">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="6,2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Active control knob (selected state) -->
    <Style x:Key="ControlKnobActive" TargetType="Button" BasedOn="{StaticResource ControlKnobButton}">
        <Setter Property="Background" Value="#2a5d3a"/>
        <Setter Property="BorderBrush" Value="#4d8a5d"/>
    </Style>

    <!-- Inactive control knob -->
    <Style x:Key="ControlKnobInactive" TargetType="Button" BasedOn="{StaticResource ControlKnobButton}">
        <Setter Property="Background" Value="#3a3a5e"/>
        <Setter Property="BorderBrush" Value="#5a5a7e"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- GAME ACTION BUTTON - In-game action buttons        -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="GameActionButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ActionBorder" CornerRadius="8" 
                            Background="{TemplateBinding Background}"
                            BorderThickness="1" BorderBrush="Transparent"
                            Padding="12,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ActionBorder" Property="BorderBrush" Value="#6a8aae"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ActionBorder" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ActionBorder" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- DEPARTMENT BUTTON - Clickable department tiles     -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="DepartmentTile" TargetType="Button">
        <Setter Property="Height" Value="120"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="TileBorder" 
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TileBorder" Property="BorderThickness" Value="3"/>
                            <Setter TargetName="TileBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#4a7aae" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- END QUARTER BUTTON - Big action button             -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="EndQuarterButton" TargetType="Button">
        <Setter Property="Height" Value="55"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="EQBorder" CornerRadius="10"
                            BorderThickness="1" BorderBrush="#6d3a6d"
                            Padding="20,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#5d2a5d" Offset="0"/>
                                <GradientStop Color="#4d1a4d" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="EQBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#7d3a7d" Offset="0"/>
                                        <GradientStop Color="#6d2a6d" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="EQBorder" Property="BorderBrush" Value="#9d5a9d"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="EQBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#3d1a3d" Offset="0"/>
                                        <GradientStop Color="#2d0a2d" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- TOOLTIP STYLE - Game-themed tooltips               -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Style x:Key="GameTooltip" TargetType="ToolTip">
        <Setter Property="Background" Value="#1a1a2e"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#3a4a6e"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- DROP SHADOW for panels                             -->
    <!-- ═══════════════════════════════════════════════════ -->
    <DropShadowEffect x:Key="PanelShadow" Color="Black" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
    <DropShadowEffect x:Key="TextGlow" Color="#4a7aae" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>

</ResourceDictionary>
