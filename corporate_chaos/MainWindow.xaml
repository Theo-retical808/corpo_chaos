<Window x:Class="CorporateChaos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CorporateChaos"
        mc:Ignorable="d"
        Title="Corporate Chaos - Beta" Height="800" Width="1400" WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="images/logo.png">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/styles/ScrollBarStyles.xaml"/>
                <ResourceDictionary Source="/styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/styles/Typography.xaml"/>
                <ResourceDictionary Source="/styles/GameTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    
    <Grid>
        <!-- Main Menu Screen -->
        <Grid x:Name="MainMenuGrid" Visibility="Visible">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1a1a2e" Offset="0"/>
                    <GradientStop Color="#16213e" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                <!-- Logo -->
                <Image Source="images/logo.png" Width="220" Height="220" Margin="0,0,0,20" 
                       HorizontalAlignment="Center"/>
                
                <!-- Game Title -->
                <TextBlock Text="CORPORATE CHAOS" FontSize="28" FontWeight="Bold" 
                          Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5"
                          FontFamily="Segoe UI" Effect="{StaticResource TextGlow}"/>
                <TextBlock Text="Build Your Empire" FontSize="13" 
                          Foreground="#7a8aae" HorizontalAlignment="Center" Margin="0,0,0,30"
                          FontFamily="Segoe UI" FontStyle="Italic"/>
                
                <Button x:Name="StoryModeBtn" Content="📖  Story Mode" 
                        Style="{StaticResource GameMenuButton}" Margin="0,5"
                        Click="StoryModeBtn_Click"
                        ToolTip="Learn corporate management through guided tutorials with Secretary Joan"/>
                <Button x:Name="SandboxModeBtn" Content="🎮  Sandbox Mode" 
                        Style="{StaticResource GameMenuButton}" Margin="0,5"
                        Click="SandboxModeBtn_Click"/>
                <Button x:Name="LoadGameBtn" Content="📁  Load Run" 
                        Style="{StaticResource GameMenuButton}" Margin="0,5"
                        Click="LoadGameBtn_Click"/>
                <Button x:Name="ScoreBoardBtn" Content="🏆  Score Board" 
                        Style="{StaticResource GameMenuButton}" Margin="0,5"
                        Click="ScoreBoardBtn_Click"/>
                <Button x:Name="OptionsBtn" Content="⚙️  Options" 
                        Style="{StaticResource GameMenuButton}" Margin="0,5"
                        Click="OptionsBtn_Click"
                        ToolTip="Adjust audio, display, and game settings"/>
                <Button x:Name="QuitGameBtn" Content="🚪  Quit Game" 
                        Style="{StaticResource GameMenuDangerButton}" Margin="0,15,0,0"
                        Click="QuitGameBtn_Click"
                        ToolTip="Exit Corporate Chaos"/>
                
                <!-- Version -->
                <TextBlock Text="v1.4" FontSize="10" Foreground="#4a5a7e" 
                          HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Save Slots Screen -->
        <Grid x:Name="SaveSlotsGrid" Visibility="Collapsed">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1a1a2e" Offset="0"/>
                    <GradientStop Color="#16213e" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <TextBlock Text="🎮 SANDBOX MODE" FontSize="26" FontWeight="Bold" 
                          Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5"
                          Effect="{StaticResource TextGlow}"/>
                <TextBlock Text="Choose your corporate challenge" FontSize="14" 
                          Foreground="#7a8aae" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                
                <Button x:Name="CorporateBtn" Content="🏢  Corporate Challenge" 
                        Style="{StaticResource GameMenuButton}" Height="60" FontSize="20"
                        Margin="0,8" Click="CorporateBtn_Click"
                        ToolTip="30-year career challenge with 120 quarters to reach 70% market share"/>
                <Button x:Name="EndlessModeBtn" Content="🏭  Endless Mode" 
                        Style="{StaticResource GameMenuButton}" Height="60" FontSize="20"
                        Margin="0,8" Click="EndlessModeBtn_Click"
                        ToolTip="Play without quarter limits - build your empire indefinitely"/>
                
                <Button x:Name="BackToMenuBtn" Content="← Back to Main Menu" 
                        Style="{StaticResource GameMenuButton}" Height="40" FontSize="14"
                        Margin="0,25,0,0" Click="BackToMenuBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- Corporate Game Screen -->
        <Grid x:Name="CorporateGameGrid" Visibility="Collapsed">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0f3460" Offset="0"/>
                    <GradientStop Color="#16537e" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0">
                        <TextBlock Text="Career: " FontSize="14" Foreground="#7a8aae" VerticalAlignment="Center"/>
                        <TextBlock x:Name="QuarterCounterText" Text="Y1 Q1 (1/120)" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,25,0"/>
                        <Border Background="#1a2a3e" CornerRadius="12" Padding="10,4" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💰 " FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HeaderCapitalText" Text="$500,000" FontSize="14" FontWeight="Bold" Foreground="#7dcea0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    
                    <TextBlock Text="CORPORATE EXECUTIVE DASHBOARD" FontSize="18" FontWeight="Bold" 
                              Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                              FontFamily="Segoe UI"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0">
                        <Button x:Name="SaveGameBtn" Content="💾 Save" 
                                Style="{StaticResource SecondaryButton}" MinWidth="80" Height="32" FontSize="12"
                                Padding="10,4" Margin="0,0,8,0" Click="SaveGameBtn_Click"/>
                        <Button x:Name="MainMenuBackBtn" Content="Main Menu" 
                                Style="{StaticResource GhostButton}" MinWidth="100" Height="32" FontSize="12"
                                Padding="10,4" Click="MainMenuBackBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Main Game Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                
                <!-- Executive Control Panel -->
                <Border Grid.Column="0" Background="#1a1a2e" CornerRadius="10" Margin="10,10,5,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource CorporateChaosScrollBar}"/>
                        </ScrollViewer.Resources>
                        <StackPanel Margin="15">
                            <TextBlock Text="🎛️ EXECUTIVE CONTROLS" FontSize="16" FontWeight="Bold" 
                                      Foreground="White" Margin="0,0,0,15"/>
                            
                            <!-- Risk Appetite -->
                            <TextBlock Text="Risk Appetite" FontSize="12" FontWeight="Bold" 
                                      Foreground="LightBlue" Margin="0,0,0,5"/>
                            <Border Background="#2a2a3e" CornerRadius="8" Padding="5" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Button x:Name="RiskConservativeBtn" Grid.Row="0" Height="25" 
                                           Background="#4a4a6a" Foreground="White" BorderThickness="1" BorderBrush="#6a6a8a"
                                           Click="RiskAppetite_Click" Tag="Conservative" Margin="0,0,0,1"
                                           ToolTip="Conservative: Lower risk, stable growth">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🛡️" FontSize="10" Margin="0,0,3,0"/>
                                            <TextBlock Text="Conservative" FontSize="9"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button x:Name="RiskBalancedBtn" Grid.Row="1" Height="25" 
                                           Background="#2a4d3a" Foreground="White" BorderThickness="1" BorderBrush="#4d7a5d"
                                           Click="RiskAppetite_Click" Tag="Balanced" Margin="0,1"
                                           ToolTip="Balanced: Moderate risk for steady progress">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚖️" FontSize="10" Margin="0,0,3,0"/>
                                            <TextBlock Text="Balanced" FontSize="9"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button x:Name="RiskAggressiveBtn" Grid.Row="2" Height="25" 
                                           Background="#4a4a6a" Foreground="White" BorderThickness="1" BorderBrush="#6a6a8a"
                                           Click="RiskAppetite_Click" Tag="Aggressive" Margin="0,1,0,0"
                                           ToolTip="Aggressive: High risk, high reward potential">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🚀" FontSize="10" Margin="0,0,3,0"/>
                                            <TextBlock Text="Aggressive" FontSize="9"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            
                            <!-- Budget Allocation -->
                            <TextBlock Text="Budget Allocation" FontSize="12" FontWeight="Bold" 
                                      Foreground="LightBlue" Margin="0,0,0,5"/>
                            <Border Background="#2a2a3e" CornerRadius="8" Padding="5" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Button x:Name="BudgetLowBtn" Grid.Row="0" Height="25" 
                                           Background="#4a4a6a" Foreground="White" BorderThickness="1" BorderBrush="#6a6a8a"
                                           Click="BudgetAllocation_Click" Tag="Low" Margin="0,0,0,1"
                                           ToolTip="Low Budget: Conservative spending, focus on essentials">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💰" FontSize="10" Margin="0,0,3,0"/>
                                            <TextBlock Text="Frugal" FontSize="9"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button x:Name="BudgetMediumBtn" Grid.Row="1" Height="25" 
                                           Background="#2a4d3a" Foreground="White" BorderThickness="1" BorderBrush="#4d7a5d"
                                           Click="BudgetAllocation_Click" Tag="Medium" Margin="0,1"
                                           ToolTip="Medium Budget: Balanced investment across departments">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💰💰" FontSize="10" Margin="0,0,3,0"/>
                                            <TextBlock Text="Moderate" FontSize="9"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button x:Name="BudgetHighBtn" Grid.Row="2" Height="25" 
                                           Background="#4a4a6a" Foreground="White" BorderThickness="1" BorderBrush="#6a6a8a"
                                           Click="BudgetAllocation_Click" Tag="High" Margin="0,1,0,0"
                                           ToolTip="High Budget: Aggressive investment for rapid growth">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💰💰💰" FontSize="10" Margin="0,0,3,0"/>
                                            <TextBlock Text="Generous" FontSize="9"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            
                            <!-- Market Strategy -->
                            <TextBlock Text="Market Strategy" FontSize="12" FontWeight="Bold" 
                                      Foreground="LightBlue" Margin="0,0,0,5"/>
                            <Border Background="#2a2a3e" CornerRadius="8" Padding="5" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Button x:Name="MarketCostBtn" Grid.Row="0" Height="25" 
                                           Background="#4a4a6a" Foreground="White" BorderThickness="1" BorderBrush="#6a6a8a"
                                           Click="MarketStrategy_Click" Tag="Cost" Margin="0,0,0,1"
                                           ToolTip="Cost Leadership: Compete on price and efficiency">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💸" FontSize="10" Margin="0,0,3,0"/>
                                            <TextBlock Text="Cost Leader" FontSize="9"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button x:Name="MarketQualityBtn" Grid.Row="1" Height="25" 
                                           Background="#2a4d3a" Foreground="White" BorderThickness="1" BorderBrush="#4d7a5d"
                                           Click="MarketStrategy_Click" Tag="Quality" Margin="0,1"
                                           ToolTip="Quality Focus: Premium products and services">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⭐" FontSize="10" Margin="0,0,3,0"/>
                                            <TextBlock Text="Quality Focus" FontSize="9"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button x:Name="MarketInnovationBtn" Grid.Row="2" Height="25" 
                                           Background="#4a4a6a" Foreground="White" BorderThickness="1" BorderBrush="#6a6a8a"
                                           Click="MarketStrategy_Click" Tag="Innovation" Margin="0,1,0,0"
                                           ToolTip="Innovation-Driven: Cutting-edge technology and R&amp;D">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔬" FontSize="10" Margin="0,0,3,0"/>
                                            <TextBlock Text="Innovation" FontSize="9"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            
                            <!-- Crisis Response -->
                            <TextBlock Text="Crisis Response" FontSize="12" FontWeight="Bold" 
                                      Foreground="LightBlue" Margin="0,0,0,5"/>
                            <Border Background="#2a2a3e" CornerRadius="8" Padding="5" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Button x:Name="CrisisImmediateBtn" Grid.Row="0" Height="25" 
                                           Background="#4a4a6a" Foreground="White" BorderThickness="1" BorderBrush="#6a6a8a"
                                           Click="CrisisResponse_Click" Tag="Immediate" Margin="0,0,0,1"
                                           ToolTip="Immediate Action: Quick response, higher costs">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡" FontSize="10" Margin="0,0,3,0"/>
                                            <TextBlock Text="Immediate" FontSize="9"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button x:Name="CrisisControlBtn" Grid.Row="1" Height="25" 
                                           Background="#2a4d3a" Foreground="White" BorderThickness="1" BorderBrush="#4d7a5d"
                                           Click="CrisisResponse_Click" Tag="Control" Margin="0,1"
                                           ToolTip="Damage Control: Balanced approach to crisis management">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🛠️" FontSize="10" Margin="0,0,3,0"/>
                                            <TextBlock Text="Control" FontSize="9"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <Button x:Name="CrisisAbsorbBtn" Grid.Row="2" Height="25" 
                                           Background="#4a4a6a" Foreground="White" BorderThickness="1" BorderBrush="#6a6a8a"
                                           Click="CrisisResponse_Click" Tag="Absorb" Margin="0,1,0,0"
                                           ToolTip="Ignore and Absorb: Minimal intervention, accept consequences">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🤷" FontSize="10" Margin="0,0,3,0"/>
                                            <TextBlock Text="Absorb" FontSize="9"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            
                            <!-- Employee Management -->
                            <TextBlock Text="👥 EMPLOYEE MANAGEMENT" FontSize="14" FontWeight="Bold" 
                                      Foreground="White" Margin="0,10,0,10"/>
                            
                            <Button x:Name="HireEmployeesBtn" Content="🎯 Hire New Employees" 
                                    Style="{StaticResource GameActionButton}"
                                    Background="#2a4d3a"
                                    Margin="0,0,0,8" Click="HireEmployeesBtn_Click"/>
                            
                            <Button x:Name="ExecutiveDecisionsBtn" Content="📈 Executive Decisions" 
                                    Style="{StaticResource GameActionButton}"
                                    Background="#4d2a4d"
                                    Margin="0,0,0,8" Click="ExecutiveDecisionsBtn_Click"/>
                            
                            <TextBlock x:Name="HiredEmployeesCountText" Text="Total Hired: 0 employees" 
                                      FontSize="11" Foreground="LightGray" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="💡 Tip: Click departments to manage employees" 
                                      FontSize="10" Foreground="Gray" TextWrapping="Wrap" 
                                      HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                
                <!-- Center Office Area (Placeholder for Graphics) -->
                <Border Grid.Column="1" Background="#16213e" CornerRadius="10" Margin="5,10">
                    <Grid>
                        <TextBlock Text="🏢 OFFICE DEPARTMENTS" FontSize="18" FontWeight="Bold" 
                                  Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"/>
                        
                        <!-- Department Grid -->
                        <UniformGrid Rows="2" Columns="3" Margin="20,60,20,20">
                            <!-- Marketing Department -->
                            <Button x:Name="MarketingDeptBtn" Height="120" Margin="5" 
                                    Click="DepartmentBtn_Click" Tag="Marketing" 
                                    BorderBrush="#4d7a5d" BorderThickness="2" Cursor="Hand">
                                <Button.Background>
                                    <ImageBrush ImageSource="images/marketing.png" Stretch="UniformToFill"/>
                                </Button.Background>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#5d8a6d"/>
                                                <Setter Property="BorderThickness" Value="3"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <!-- Dark overlay for text readability -->
                                    <Rectangle Fill="Black" Opacity="0.4"/>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <Border Background="#FF4444" CornerRadius="10" Width="20" Height="20" 
                                               HorizontalAlignment="Right" Margin="0,0,5,5">
                                            <TextBlock x:Name="MarketingEmployeeCount" Text="0" FontSize="10" FontWeight="Bold" 
                                                      Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Marketing" FontSize="14" FontWeight="Bold" 
                                                  Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5"
                                                  Effect="{StaticResource DropShadowEffect}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            
                            <!-- Operations Department -->
                            <Button x:Name="OperationsDeptBtn" Height="120" Margin="5" 
                                    Click="DepartmentBtn_Click" Tag="Operations" 
                                    BorderBrush="#7a4d4d" BorderThickness="2" Cursor="Hand">
                                <Button.Background>
                                    <ImageBrush ImageSource="images/operations.png" Stretch="UniformToFill"/>
                                </Button.Background>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#8a5d5d"/>
                                                <Setter Property="BorderThickness" Value="3"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <!-- Dark overlay for text readability -->
                                    <Rectangle Fill="Black" Opacity="0.4"/>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <Border Background="#FF4444" CornerRadius="10" Width="20" Height="20" 
                                               HorizontalAlignment="Right" Margin="0,0,5,5">
                                            <TextBlock x:Name="OperationsEmployeeCount" Text="0" FontSize="10" FontWeight="Bold" 
                                                      Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Operations" FontSize="14" FontWeight="Bold" 
                                                  Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5"
                                                  Effect="{StaticResource DropShadowEffect}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            
                            <!-- Finance Department -->
                            <Button x:Name="FinanceDeptBtn" Height="120" Margin="5" 
                                    Click="DepartmentBtn_Click" Tag="Finance" 
                                    BorderBrush="#4d4d7a" BorderThickness="2" Cursor="Hand">
                                <Button.Background>
                                    <ImageBrush ImageSource="images/finance.png" Stretch="UniformToFill"/>
                                </Button.Background>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#5d5d8a"/>
                                                <Setter Property="BorderThickness" Value="3"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <!-- Dark overlay for text readability -->
                                    <Rectangle Fill="Black" Opacity="0.4"/>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <Border Background="#FF4444" CornerRadius="10" Width="20" Height="20" 
                                               HorizontalAlignment="Right" Margin="0,0,5,5">
                                            <TextBlock x:Name="FinanceEmployeeCount" Text="0" FontSize="10" FontWeight="Bold" 
                                                      Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Finance" FontSize="14" FontWeight="Bold" 
                                                  Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5"
                                                  Effect="{StaticResource DropShadowEffect}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            
                            <!-- HR Department -->
                            <Button x:Name="HRDeptBtn" Height="120" Margin="5" 
                                    Click="DepartmentBtn_Click" Tag="HR" 
                                    BorderBrush="#7a5d4d" BorderThickness="2" Cursor="Hand">
                                <Button.Background>
                                    <ImageBrush ImageSource="images/human_resources.png" Stretch="UniformToFill"/>
                                </Button.Background>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#8a6d5d"/>
                                                <Setter Property="BorderThickness" Value="3"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <!-- Dark overlay for text readability -->
                                    <Rectangle Fill="Black" Opacity="0.4"/>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <Border Background="#FF4444" CornerRadius="10" Width="20" Height="20" 
                                               HorizontalAlignment="Right" Margin="0,0,5,5">
                                            <TextBlock x:Name="HREmployeeCount" Text="0" FontSize="10" FontWeight="Bold" 
                                                      Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Human Resources" FontSize="14" FontWeight="Bold" 
                                                  Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5"
                                                  Effect="{StaticResource DropShadowEffect}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            
                            <!-- IT Department -->
                            <Button x:Name="ITDeptBtn" Height="120" Margin="5" 
                                    Click="DepartmentBtn_Click" Tag="IT" 
                                    BorderBrush="#5d4d7a" BorderThickness="2" Cursor="Hand">
                                <Button.Background>
                                    <ImageBrush ImageSource="images/it.png" Stretch="UniformToFill"/>
                                </Button.Background>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#6d5d8a"/>
                                                <Setter Property="BorderThickness" Value="3"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <!-- Dark overlay for text readability -->
                                    <Rectangle Fill="Black" Opacity="0.4"/>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <Border Background="#FF4444" CornerRadius="10" Width="20" Height="20" 
                                               HorizontalAlignment="Right" Margin="0,0,5,5">
                                            <TextBlock x:Name="ITEmployeeCount" Text="0" FontSize="10" FontWeight="Bold" 
                                                      Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="IT" FontSize="14" FontWeight="Bold" 
                                                  Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5"
                                                  Effect="{StaticResource DropShadowEffect}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            
                            <!-- Research Department -->
                            <Button x:Name="ResearchDeptBtn" Height="120" Margin="5" 
                                    Click="DepartmentBtn_Click" Tag="Research" 
                                    BorderBrush="#4d7a7a" BorderThickness="2" Cursor="Hand">
                                <Button.Background>
                                    <ImageBrush ImageSource="images/research.png" Stretch="UniformToFill"/>
                                </Button.Background>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#5d8a8a"/>
                                                <Setter Property="BorderThickness" Value="3"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <!-- Dark overlay for text readability -->
                                    <Rectangle Fill="Black" Opacity="0.4"/>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <Border Background="#FF4444" CornerRadius="10" Width="20" Height="20" 
                                               HorizontalAlignment="Right" Margin="0,0,5,5">
                                            <TextBlock x:Name="ResearchEmployeeCount" Text="0" FontSize="10" FontWeight="Bold" 
                                                      Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Research" FontSize="14" FontWeight="Bold" 
                                                  Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5"
                                                  Effect="{StaticResource DropShadowEffect}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </UniformGrid>
                    </Grid>
                </Border>
                
                <!-- Statistics and Events Panel -->
                <Border Grid.Column="2" Background="#1a1a2e" CornerRadius="10" Margin="5,10,10,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Story Progress Panel (Story Mode Only) -->
                        <Border x:Name="StoryProgressPanel" Grid.Row="0" Background="#2a1a3e" CornerRadius="5" 
                                Margin="10,10,10,5" Padding="8" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="📖 STORY PROGRESS" FontSize="12" FontWeight="Bold" 
                                          Foreground="#b19cd9" Margin="0,0,0,8"/>
                                
                                <!-- Current Act -->
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Act: " FontSize="10" Foreground="Gray" Width="60"/>
                                    <TextBlock x:Name="CurrentActText" Text="Tutorial" FontSize="10" 
                                              FontWeight="Bold" Foreground="#d4a5ff"/>
                                </StackPanel>
                                
                                <!-- Act Progress Bar -->
                                <Grid Margin="0,4,0,2">
                                    <Border Background="#1a1a2e" CornerRadius="3" Height="6"/>
                                    <Border x:Name="ActProgressBar" Background="#8b5cf6" CornerRadius="3" 
                                            Height="6" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                                <TextBlock x:Name="ActProgressText" Text="Q1 of 10" FontSize="9" 
                                          Foreground="LightGray" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- Company Statistics -->
                        <Border Grid.Row="1" Background="#16213e" CornerRadius="5" Margin="10,5,10,5"
                                BorderBrush="#2a3a5e" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource CorporateChaosScrollBar}"/>
                                </ScrollViewer.Resources>
                                <StackPanel Margin="10">
                                    <TextBlock Text="📊 COMPANY STATS" FontSize="13" FontWeight="Bold" 
                                              Foreground="White" Margin="0,0,0,10"/>
                                    
                                    <!-- Capital -->
                                    <StackPanel Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="💰 Capital" FontSize="10" Foreground="#7a8aae"/>
                                            <TextBlock x:Name="CapitalText" Text="$500,000" FontSize="11" FontWeight="Bold" 
                                                      Foreground="#7dcea0" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                    
                                    <!-- Market Share with bar -->
                                    <StackPanel Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="📈 Market Share" FontSize="10" Foreground="#7a8aae"/>
                                            <TextBlock x:Name="MarketShareText" Text="5%" FontSize="11" FontWeight="Bold" 
                                                      Foreground="#85c1e9" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,3,0,0">
                                            <Border Background="#1a1a2e" CornerRadius="3" Height="6"/>
                                            <Border x:Name="MarketShareBar" Background="#3498db" CornerRadius="3" 
                                                    Height="6" HorizontalAlignment="Left" Width="0"/>
                                        </Grid>
                                    </StackPanel>
                                    
                                    <!-- Reputation with bar -->
                                    <StackPanel Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="⭐ Reputation" FontSize="10" Foreground="#7a8aae"/>
                                            <TextBlock x:Name="ReputationText" Text="50" FontSize="11" FontWeight="Bold" 
                                                      Foreground="#f9e79f" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,3,0,0">
                                            <Border Background="#1a1a2e" CornerRadius="3" Height="6"/>
                                            <Border x:Name="ReputationBar" Background="#f1c40f" CornerRadius="3" 
                                                    Height="6" HorizontalAlignment="Left" Width="0"/>
                                        </Grid>
                                    </StackPanel>
                                    
                                    <!-- Morale with bar -->
                                    <StackPanel Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="😊 Morale" FontSize="10" Foreground="#7a8aae"/>
                                            <TextBlock x:Name="MoraleText" Text="50" FontSize="11" FontWeight="Bold" 
                                                      Foreground="#f5b7b1" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,3,0,0">
                                            <Border Background="#1a1a2e" CornerRadius="3" Height="6"/>
                                            <Border x:Name="MoraleBar" Background="#e74c8b" CornerRadius="3" 
                                                    Height="6" HorizontalAlignment="Left" Width="0"/>
                                        </Grid>
                                    </StackPanel>
                                    
                                    <!-- Risk with bar -->
                                    <StackPanel Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="⚠️ Risk" FontSize="10" Foreground="#7a8aae"/>
                                            <TextBlock x:Name="RiskText" Text="10" FontSize="11" FontWeight="Bold" 
                                                      Foreground="#f0b27a" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,3,0,0">
                                            <Border Background="#1a1a2e" CornerRadius="3" Height="6"/>
                                            <Border x:Name="RiskBar" Background="#e67e22" CornerRadius="3" 
                                                    Height="6" HorizontalAlignment="Left" Width="0"/>
                                        </Grid>
                                    </StackPanel>
                                    
                                    <!-- Employees -->
                                    <StackPanel Margin="0,0,0,4">
                                        <Grid>
                                            <TextBlock Text="👥 Employees" FontSize="10" Foreground="#7a8aae"/>
                                            <TextBlock x:Name="EmployeeCountText" Text="0" FontSize="11" FontWeight="Bold" 
                                                      Foreground="#85e0e0" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                    
                                    <!-- Story Mode: Relationships Button -->
                                    <Button x:Name="RelationshipsBtn" Content="💕 Relationships" 
                                           Style="{StaticResource GameActionButton}"
                                           Background="#4d2a4d" Height="35"
                                           Margin="0,10,0,0" Click="RelationshipsBtn_Click"
                                           Visibility="Collapsed"
                                           ToolTip="View your relationships with story characters"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        
                        <!-- Current Events and Crisis Status -->
                        <Grid Grid.Row="2" Margin="10,5,10,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Crisis Status -->
                            <Border Grid.Row="0" Background="#16213e" CornerRadius="5" Margin="0,0,0,5">
                                <StackPanel Margin="10">
                                    <TextBlock Text="🚨 CRISIS STATUS" FontSize="14" FontWeight="Bold" 
                                              Foreground="White" Margin="0,0,0,10"/>
                                    <ScrollViewer Height="80" VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="CrisisStatusText" Text="🟢 No active crises" 
                                                  FontSize="10" Foreground="White" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                            
                            <!-- Current Events Button -->
                            <Border Grid.Row="1" Background="#16213e" CornerRadius="5" Margin="0,5,0,0">
                                <Grid Margin="10">
                                    <Button x:Name="CurrentEventsBtn" Background="#2a4d3a" BorderBrush="#4d7a5d" 
                                           BorderThickness="2" Height="50" Click="CurrentEventsBtn_Click"
                                           Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#2a4d3a"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#3a5d4a"/>
                                                        <Setter Property="BorderBrush" Value="#5d8a6d"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid>
                                            <TextBlock Text="📰 View Quarterly Summary" FontSize="14" FontWeight="Bold" 
                                                      Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Ellipse x:Name="NewEventsIndicator" Width="8" Height="8" Fill="Red" 
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" 
                                                    Margin="0,5,5,0" Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
            
            <!-- Bottom Control Panel -->
            <Border Grid.Row="2" BorderBrush="#2a3a5e" BorderThickness="0,2,0,0" Margin="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1a1a2e" Offset="0"/>
                        <GradientStop Color="#141428" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Quarterly Summary -->
                    <StackPanel Grid.Column="0">
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="📋 QUARTERLY SUMMARY" FontSize="16" FontWeight="Bold" 
                                      Foreground="White"/>
                            <Button x:Name="FinancialReportBtn" Content="📑 Financial Report" 
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButton}" 
                                    Height="28" FontSize="11" Padding="10,3"
                                    Click="FinancialReportBtn_Click"
                                    ToolTip="View detailed financial breakdown of the previous quarter"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Revenue" FontSize="12" Foreground="Gray"/>
                                <TextBlock x:Name="QuarterlyRevenueText" Text="$0" FontSize="14" FontWeight="Bold" Foreground="LightGreen"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Expenses" FontSize="12" Foreground="Gray"/>
                                <TextBlock x:Name="QuarterlyExpensesText" Text="$0" FontSize="14" FontWeight="Bold" Foreground="LightCoral"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="NetResultLabel" Text="Net Profit" FontSize="12" Foreground="Gray"/>
                                <TextBlock x:Name="NetResultText" Text="$0" FontSize="14" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Secretary Joan Assistant -->
                    <Border Grid.Column="1" Background="#16213e" CornerRadius="10" Padding="10" Margin="10,0">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Joan's Avatar -->
                            <Border Width="50" Height="50" CornerRadius="25" Background="White" Margin="0,0,0,5">
                                <Image x:Name="JoanMainAvatar" Width="45" Height="45" 
                                      Stretch="UniformToFill" ClipToBounds="True">
                                    <Image.Clip>
                                        <EllipseGeometry Center="22.5,22.5" RadiusX="22.5" RadiusY="22.5"/>
                                    </Image.Clip>
                                </Image>
                            </Border>
                            
                            <!-- Joan's Info -->
                            <TextBlock Text="Secretary Joan" FontSize="10" FontWeight="Bold" 
                                      Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Your Assistant" FontSize="8" 
                                      Foreground="LightBlue" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            
                            <!-- Joan's Dialogue Button -->
                            <Button x:Name="JoanDialogueBtn" Content="💬" Width="30" Height="25" 
                                   Background="#2a4d3a" Foreground="White"
                                   BorderThickness="0" FontSize="12" Click="JoanDialogueBtn_Click"
                                   ToolTip="Get advice from Secretary Joan">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#2a4d3a"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#3a6d4a"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            
                            <!-- Characters Button -->
                            <Button x:Name="CharactersBtn" Content="👥" Width="30" Height="25" 
                                   Background="#4d2a4d" Foreground="White" Margin="0,5,0,0"
                                   BorderThickness="0" FontSize="12" Click="CharactersBtn_Click"
                                   ToolTip="Talk to characters you've met"
                                   Visibility="Collapsed">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#4d2a4d"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#6d3a6d"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            
                            <!-- Music Toggle Button -->
                            <Button x:Name="MusicToggleBtn" Content="🔊" Width="30" Height="25" 
                                   Background="#4d3a2a" Foreground="White" Margin="0,5,0,0"
                                   BorderThickness="0" FontSize="12" Click="MusicToggleBtn_Click"
                                   ToolTip="Toggle background music on/off">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#4d3a2a"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#6d4a3a"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                    
                    <!-- End Quarter Button -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button x:Name="EndQuarterBtn" Content="⏭️ End Quarter" 
                                Style="{StaticResource EndQuarterButton}"
                                Click="EndQuarterBtn_Click"/>
                        <TextBlock Text="Make strategic decisions before ending the quarter" 
                                  FontSize="10" Foreground="#5a6a8e" TextWrapping="Wrap" 
                                  HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- TUTORIAL OVERLAY — spans all rows, sits above game content -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid x:Name="TutorialOverlay" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="9999"
                  Visibility="Collapsed" IsHitTestVisible="False">
                
                <!-- Dim background (subtle, so game is still visible) -->
                <Rectangle x:Name="TutorialDimmer" Fill="Black" Opacity="0.35" IsHitTestVisible="False"/>
                
                <!-- Joan chat bubble panel — bottom LEFT (default) -->
                <Border x:Name="JoanChatPanel" 
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="20,0,0,210" MaxWidth="480"
                        Visibility="Collapsed" IsHitTestVisible="True">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Joan avatar -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,10,0">
                            <Border Width="60" Height="60" CornerRadius="30" Background="White">
                                <Border.Effect>
                                    <DropShadowEffect Color="#4a9eff" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
                                </Border.Effect>
                                <Image x:Name="TutorialJoanAvatar" Width="56" Height="56"
                                       Stretch="UniformToFill" ClipToBounds="True">
                                    <Image.Clip>
                                        <EllipseGeometry Center="28,28" RadiusX="28" RadiusY="28"/>
                                    </Image.Clip>
                                </Image>
                            </Border>
                            <TextBlock Text="Joan" FontSize="9" Foreground="#85c1e9" 
                                      HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <!-- Chat bubble (tail points LEFT toward Joan) -->
                        <Grid Grid.Column="1">
                            <!-- Bubble tail pointing left -->
                            <Path Data="M 0,20 L -10,28 L 0,36" 
                                  Fill="#1e3a5e" Stroke="#3a6a9e" StrokeThickness="1"
                                  HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                  Margin="-1,0,0,14"/>
                            
                            <Border Background="#1e3a5e" CornerRadius="12" Padding="16,12"
                                    BorderBrush="#3a6a9e" BorderThickness="1">
                                <StackPanel>
                                    <!-- Step indicator -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock x:Name="TutorialStepText" Text="Step 1 of 3" 
                                                  FontSize="10" Foreground="#85c1e9" FontWeight="Bold"/>
                                        <TextBlock x:Name="TutorialMechanicText" Text=" · Basic Operations" 
                                                  FontSize="10" Foreground="#5a8aae"/>
                                    </StackPanel>
                                    
                                    <!-- Title -->
                                    <TextBlock x:Name="TutorialTitleText" Text="Welcome to Corporate Chaos!" 
                                              FontSize="14" FontWeight="Bold" Foreground="White"
                                              TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    
                                    <!-- Message -->
                                    <TextBlock x:Name="TutorialMessageText" 
                                              Text="I'm Secretary Joan, your personal assistant. Let me guide you through running your company."
                                              FontSize="12" Foreground="#c8d8e8" TextWrapping="Wrap"
                                              LineHeight="18" Margin="0,0,0,12"/>
                                    
                                    <!-- Navigation buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="TutorialPrevBtn" Content="← Back" 
                                                Height="28" Padding="12,4" FontSize="11"
                                                Background="#2a3a5e" Foreground="#85c1e9"
                                                BorderBrush="#3a5a8e" BorderThickness="1"
                                                Margin="0,0,8,0" Click="TutorialPrevBtn_Click"
                                                Visibility="Collapsed" IsHitTestVisible="True"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#2a3a5e"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#3a4a7e"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button x:Name="TutorialNextBtn" Content="Got it! →" 
                                                Height="28" Padding="14,4" FontSize="11" FontWeight="Bold"
                                                Background="#2a5d3a" Foreground="White"
                                                BorderBrush="#4d8a5d" BorderThickness="1"
                                                Click="TutorialNextBtn_Click"
                                                IsHitTestVisible="True" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#2a5d3a"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#3a7d4a"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Joan chat bubble panel — bottom RIGHT (used when highlight is on left panel) -->
                <Border x:Name="JoanChatPanelRight" 
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,20,210" MaxWidth="480"
                        Visibility="Collapsed" IsHitTestVisible="True">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>

                        <!-- Chat bubble (tail points RIGHT toward Joan) -->
                        <Grid Grid.Column="0">
                            <!-- Bubble tail pointing right -->
                            <Path Data="M 0,20 L 10,28 L 0,36" 
                                  Fill="#1e3a5e" Stroke="#3a6a9e" StrokeThickness="1"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Margin="0,0,-1,14"/>

                            <Border Background="#1e3a5e" CornerRadius="12" Padding="16,12"
                                    BorderBrush="#3a6a9e" BorderThickness="1">
                                <StackPanel>
                                    <!-- Step indicator -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock x:Name="TutorialStepTextR" Text="Step 1 of 3" 
                                                  FontSize="10" Foreground="#85c1e9" FontWeight="Bold"/>
                                        <TextBlock x:Name="TutorialMechanicTextR" Text=" · Basic Operations" 
                                                  FontSize="10" Foreground="#5a8aae"/>
                                    </StackPanel>

                                    <!-- Title -->
                                    <TextBlock x:Name="TutorialTitleTextR" Text="Welcome to Corporate Chaos!" 
                                              FontSize="14" FontWeight="Bold" Foreground="White"
                                              TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <!-- Message -->
                                    <TextBlock x:Name="TutorialMessageTextR" 
                                              Text="I'm Secretary Joan, your personal assistant."
                                              FontSize="12" Foreground="#c8d8e8" TextWrapping="Wrap"
                                              LineHeight="18" Margin="0,0,0,12"/>

                                    <!-- Navigation buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="TutorialPrevBtnR" Content="← Back" 
                                                Height="28" Padding="12,4" FontSize="11"
                                                Background="#2a3a5e" Foreground="#85c1e9"
                                                BorderBrush="#3a5a8e" BorderThickness="1"
                                                Margin="0,0,8,0" Click="TutorialPrevBtn_Click"
                                                Visibility="Collapsed" IsHitTestVisible="True"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#2a3a5e"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#3a4a7e"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button x:Name="TutorialNextBtnR" Content="Got it! →" 
                                                Height="28" Padding="14,4" FontSize="11" FontWeight="Bold"
                                                Background="#2a5d3a" Foreground="White"
                                                BorderBrush="#4d8a5d" BorderThickness="1"
                                                Click="TutorialNextBtn_Click"
                                                IsHitTestVisible="True" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#2a5d3a"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#3a7d4a"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Joan avatar (right side) -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="10,0,0,0">
                            <Border Width="60" Height="60" CornerRadius="30" Background="White">
                                <Border.Effect>
                                    <DropShadowEffect Color="#4a9eff" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
                                </Border.Effect>
                                <Image x:Name="TutorialJoanAvatarR" Width="56" Height="56"
                                       Stretch="UniformToFill" ClipToBounds="True">
                                    <Image.Clip>
                                        <EllipseGeometry Center="28,28" RadiusX="28" RadiusY="28"/>
                                    </Image.Clip>
                                </Image>
                            </Border>
                            <TextBlock Text="Joan" FontSize="9" Foreground="#85c1e9" 
                                      HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Highlight ring — positioned programmatically from code-behind -->
                <Border x:Name="TutorialHighlightRing" 
                        BorderBrush="#f0c040" BorderThickness="3" CornerRadius="8"
                        Background="Transparent" IsHitTestVisible="False"
                        Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Border.Effect>
                        <DropShadowEffect Color="#f0c040" BlurRadius="16" ShadowDepth="0" Opacity="0.8"/>
                    </Border.Effect>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="1.0" To="0.4" Duration="0:0:0.7"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
